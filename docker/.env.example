# Copy to docker/.env and fill in. docker/.env is git-ignored.
# Compose loads this file automatically when the compose file lives in docker/.

# --- Cloudflare Tunnel (REQUIRED) ---
# Zero Trust dashboard -> Networks -> Tunnels -> Create -> Docker -> copy the token.
# Then add a Public Hostname pointing to service http://waha:3000
CLOUDFLARE_TUNNEL_TOKEN=

# --- WAHA ---
WAHA_PORT=3000
WAHA_API_KEY=change-me
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WAHA_ENGINE=WEBJS
WAHA_LOG_LEVEL=info

# Backend webhook receiver running on the host machine.
WAHA_WEBHOOK_URL=http://host.docker.internal:5000/api/waha/webhook
WAHA_WEBHOOK_EVENTS=message,message.any,message.ack,message.reaction,session.status,state.change,group.join,group.leave
WAHA_WEBHOOK_RETRIES=15
WAHA_WEBHOOK_RETRY_DELAY=2
# Optional shared secret; WAHA signs payloads in the X-Webhook-Hmac header.
WAHA_WEBHOOK_HMAC_KEY=

# --- MongoDB ---
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root
MONGO_DATABASE=engzny

TZ=UTC
